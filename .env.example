# Copy this file to .env and fill in the values from the GW guide. Never commit .env.
GW_AZURE_OPENAI_KEY=
# Azure resource endpoint, for example https://<resource-name>.openai.azure.com/
GW_ENDPOINT=
# Deployment name of the chat model, as given by GW.
GW_MODEL=gpt-5.4
GW_API_VERSION=2025-03-01-preview
# Reasoning effort for the model. GW offers medium.
GW_REASONING_EFFORT=medium
